+// Interlaced games can alternate light and heavy fields. Average a few host
+// intervals before adjusting playback speed, or an asymmetric attack/recovery
+// filter biases the estimate toward the heavy fields.
+AUDIO_SPEED_SAMPLES :: 4
+
+Audio_Speed :: struct {
+	value:   f64,
+	elapsed: [AUDIO_SPEED_SAMPLES]f64,
+	total:   f64,
+	count:   int,
+	next:    int,
+}
+
+audio_speed_update :: proc(state: ^Audio_Speed, expected_seconds, elapsed_seconds: f64) -> f64 {
+	if expected_seconds <= 0 || elapsed_seconds <= 0 || elapsed_seconds > expected_seconds * 4 {
+		return state.value
+	}
+	if state.count == AUDIO_SPEED_SAMPLES {
+		state.total -= state.elapsed[state.next]
+	} else {
+		state.count += 1
+	}
+	state.elapsed[state.next] = elapsed_seconds
+	state.total += elapsed_seconds
+	state.next = (state.next + 1) % AUDIO_SPEED_SAMPLES
+
+	target := clamp(expected_seconds * f64(state.count) / state.total, AUDIO_MIN_SPEED, 1)
+	if target > 0.98 {target = 1}
+	weight := target < state.value ? 0.5 : 0.125
+	state.value += (target - state.value) * weight
+	if state.value > 0.995 {state.value = 1}
+	return state.value
+}
