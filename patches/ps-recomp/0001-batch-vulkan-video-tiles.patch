@@ -1019,0 +1055 @@ hw_state :: proc(c: ^Ctx) -> u32 {
+		if hw.direct_ok {f += {.DIRECT}}
@@ -1039,2 +1075,2 @@ hw_state :: proc(c: ^Ctx) -> u32 {
-	if c.tme {st.dec, st.dec_ls = hw.state.dec, hw.state.dec_ls}
-	if hw.state_ok && st == hw.state && (!c.tme || hw.dec_seq == hw.seq) {return hw.state_idx}
+	if c.tme && !hw.direct_ok {st.dec, st.dec_ls = hw.state.dec, hw.state.dec_ls}
+	if !hw.direct_ok && hw.state_ok && st == hw.state && (!c.tme || hw.dec_seq == hw.seq) {return hw.state_idx}
@@ -1045,8 +1081,12 @@ hw_state :: proc(c: ^Ctx) -> u32 {
-		st.dec, st.dec_ls = hw_dec(t, &st, tex)
-		hw.dec_seq = hw.seq
-		// Not decoded but sharing a page with the frame or depth buffer: the
-		// pages as they stand before the primitive, as hw_dec takes them.
-		if st.dec == 0 && (spans_meet(tex, fb) || spans_meet(tex, z)) {
-			hw_snap(tex)
-			f += {.SNAP}
-			st.flags = transmute(u32)f
+		if hw.direct_ok {
+			st.dec = hw.direct_off
+		} else {
+			st.dec, st.dec_ls = hw_dec(t, &st, tex)
+			hw.dec_seq = hw.seq
+			// Not decoded but sharing a page with the frame or depth buffer: the
+			// pages as they stand before the primitive, as hw_dec takes them.
+			if st.dec == 0 && (spans_meet(tex, fb) || spans_meet(tex, z)) {
+				hw_snap(tex)
+				f += {.SNAP}
+				st.flags = transmute(u32)f
+			}
@@ -1138,0 +1179,29 @@ sprite_snap :: proc(vs: []Hw_Vert, point: bool, fst: bool, tw, th: u32) {
+@(private)
+hw_direct_upload :: proc(c: ^Ctx) -> bool {
+	u, t := &hw.up, &c.tex
+	// Sofdec replaces this 16x16 scratch texture for every movie tile.
+	// Ordinary gameplay textures stay on the device-local decode path.
+	SOFDEC_BP :: 13456
+	if hw.scale > 3 || !u.active || !c.tme || u.psm != PSMCT32 || t.psm != PSMCT32 ||
+	   u.bp != SOFDEC_BP || u.bp != t.tbp || u.bw != 1 || t.tbw != 1 ||
+	   u.x0 != 0 || u.y0 != 0 || u.w != 16 || t.w != 16 || t.h != 16 ||
+	   u.start != 0 || u.count != 16 * 16 || t.mxl != 0 {
+		return false
+	}
+	fb := page_span(c.fpsm, c.fbp, c.fbw, u32(c.sy0), u32(c.sy1))
+	z := c.zte && !c.zmsk ? page_span(c.zpsm, c.zbp, c.fbw, u32(c.sy0), u32(c.sy1)) : {}
+	tex := tex_span(t)
+	if spans_meet(tex, fb) || spans_meet(tex, z) {return false}
+	if hw.deferred.active && !hw_upload_same(&hw.deferred, u) {
+		hw_flush_deferred_upload()
+	}
+	d := u^
+	u.active = false
+	pages_write(rect_pages(d.psm, d.bp, d.bw, d.x0, d.y0, d.w, d.count / d.w))
+	hw.deferred = d
+	hw.deferred.active = true
+	hw.direct_off = u32(d.first)
+	hw.state_ok = false
+	return true
+}
+
