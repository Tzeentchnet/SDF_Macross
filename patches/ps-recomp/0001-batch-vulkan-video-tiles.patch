index 3b1c79f45895397adbff116a6c165b33e79190c6..02b4d4e1806ef28dc5525df1c8cdcc40cee72733 100644
--- a/ps2/gs/shaders/prim.frag
+++ b/ps2/gs/shaders/prim.frag
@@ -43,0 +44 @@ uint fetch(uint x, uint y) {
+	if ((S.flags & F_DIRECT) != 0u) return pc.direct.w[DEC + y * DW + x];
@@ -83,2 +84,6 @@ ivec4 sample_level(uint n, float u, float v, bool bilinear) {
-		uint x = wrap_coord(int(floor(u)), wms, w, minu, maxu);
-		uint y = wrap_coord(int(floor(v)), wmt, h, minv, maxv);
+		// Odd internal scales can put a 1:1 sprite's interpolated coordinate
+		// just below an integer. Direct uploads preserve the exact GS texels,
+		// so bias by far less than one UV fixed-point step before flooring.
+		float eps = (S.flags & F_DIRECT) != 0u ? 1.0 / 4096.0 : 0.0;
+		uint x = wrap_coord(int(floor(u + eps)), wms, w, minu, maxu);
+		uint y = wrap_coord(int(floor(v + eps)), wmt, h, minv, maxv);
