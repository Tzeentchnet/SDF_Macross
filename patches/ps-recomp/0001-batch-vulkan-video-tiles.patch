-	if !u.active {return}
-	u.active = false
+hw_upload_same :: proc(a, b: ^Hw_Upload) -> bool {
+	return a.psm == b.psm && a.bp == b.bp && a.bw == b.bw &&
+	       a.x0 == b.x0 && a.y0 == b.y0 && a.w == b.w &&
+	       a.start == b.start && a.count == b.count
