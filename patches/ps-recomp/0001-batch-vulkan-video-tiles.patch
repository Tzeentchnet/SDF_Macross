+		if !u.active {
+			u^ = {true, psm, bp, bw, x0, y0, w, start, 0, s.nup}
+		} else if !(u.psm == psm && u.bp == bp && u.bw == bw && u.x0 == x0 && u.y0 == y0 && u.w == w &&
