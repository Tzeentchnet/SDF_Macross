diff --git a/tests/gs_hw/main.odin b/tests/gs_hw/main.odin
index a3ed16202b32a481d73dd5c7178469b948651d0c..732e5e6826e4e81faf6349b95d1c33acaa169886 100644
--- a/tests/gs_hw/main.odin
+++ b/tests/gs_hw/main.odin
@@ -51,0 +52,3 @@ ROUNDS :: 2
+@(private = "file")
+scale_under_test: u32
+
@@ -75,0 +79 @@ CASES := [?]Case {
+	{"direct uploads", direct_uploads},
@@ -334,0 +339,38 @@ halves :: proc() {
+// Repeated complete uploads to one disjoint texture, each sampled by the
+// sprite immediately after it. The GPU may batch the sprites only while each
+// state keeps its own uploaded pixels and the last upload reaches local memory.
+@(private = "file")
+direct_uploads :: proc() {
+	if scale_under_test > 3 {return}
+	TBP :: 13456
+	picture(0, 4, W, H)
+	setup(4 << 16, 0x100 | ZMSK, 0, 0, tex0(TBP, 1, 4, 4))
+	seq: u32
+	for ty in 0 ..< H / 16 {
+		for tx in 0 ..< W / 16 {
+			px: [16 * 16]u32
+			seed := 0x9e3779b9 ~ seq
+			for &v in px {
+				seed ~= seed << 13
+				seed ~= seed >> 17
+				seed ~= seed << 5
+				v = seed
+			}
+			gs.gs_write(0x50, u64(TBP) << 32 | 1 << 48) // BITBLTBUF
+			gs.gs_write(0x51, 0) // TRXPOS
+			gs.gs_write(0x52, 16 | 16 << 32) // TRXREG
+			gs.gs_write(0x53, 0) // TRXDIR: host to local
+			gs.transfer(slice.to_bytes(px[:]))
+
+			x0, y0 := u64(tx * 16), u64(ty * 16)
+			gs.gs_write(0x00, 6 | 1 << 4 | 1 << 8) // PRIM: SPRITE, TME, FST
+			gs.gs_write(0x01, 0x80808080)
+			gs.gs_write(0x03, 0) // UV
+			gs.gs_write(0x05, x0 << 4 | y0 << 20 | u64(seq + 1) << 32)
+			gs.gs_write(0x03, 16 << 4 | (16 << 4) << 16)
+			gs.gs_write(0x05, (x0 + 16) << 4 | (y0 + 16) << 20 | u64(seq + 1) << 32)
+			seq += 1
+		}
+	}
+}
+
@@ -369,0 +412 @@ child :: proc(scale: u32) -> ! {
+	scale_under_test = scale
