-	hw_flush_upload()
+	hw.direct_ok = hw_direct_upload(c)
+	if !hw.direct_ok {hw_flush_upload()}
@@ -1153 +1223 @@ hw_draw :: proc(c: ^Ctx, kind: u64) {
-		if pages_hit(&hw.dirty, hw.tex_pages) {hw_split()}
+		if !hw.direct_ok && pages_hit(&hw.dirty, hw.tex_pages) {hw_split()}
