+	if track_pages {
+		pages_write(rect_pages(u.psm, u.bp, u.bw, u.x0, u.y0 + u.start / u.w, u.w, (u.start + u.count - 1) / u.w - u.start / u.w + 1))
+	}
@@ -467,0 +481,20 @@ hw_flush_upload :: proc() {
+@(private)
+hw_flush_deferred_upload :: proc() {
+	if !hw.deferred.active {return}
+	u := hw.deferred
+	hw.deferred.active = false
+	hw_record_upload(&u, false)
+}
+
+@(private)
+hw_flush_upload :: proc() {
+	if !hw.up.active {
+		hw_flush_deferred_upload()
+		return
+	}
+	u := hw.up
+	hw.up.active = false
+	hw_flush_deferred_upload()
+	hw_record_upload(&u, true)
+}
+
